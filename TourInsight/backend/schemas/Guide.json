      "type": "string",
      "required": true
    },
    "destination": {
      "type": "string"
    },
    "country": {
      "type": "string"
    },
    "languages": {
      "type": "array",
      "items": "string"
    },
    "specialties": {
      "type": "array",
      "items": "string"
    },
    "price_per_day": {
      "type": "number"
    },
    "rating": {
      "type": "number"
    },
    "phone": {
      "type": "string"
    },
